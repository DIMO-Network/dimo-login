{
  "name": "dimo-login",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@dimo-network/transactions": "0.4.1",
    "@heroicons/react": "^2.2.0",
    "@sentry/cli": "^3.8.2",
    "@sentry/react": "^11.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@turnkey/api-key-stamper": "0.6.17",
    "@turnkey/crypto": "2.13.2",
    "@turnkey/encoding": "0.6.0",
    "@turnkey/http": "6.6.0",
    "@turnkey/webauthn-stamper": "0.6.0",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.5.11",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-mobile-app-button": "1.2.18",
    "tailwind-merge": "^3.7.0",
    "typescript": "~6.0.3",
    "viem": "2.56.8"
  },
  "overrides": {
    "react-refresh": "0.14.2",
    "@turnkey/http": "6.6.0",
    "@turnkey/viem": "0.14.43",
    "underscore": "^1.13.8",
    "react-mobile-app-button": {
      "vite": "^6.4.5"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && if [ -z \"$SENTRY_AUTH_TOKEN\" ]; then vite build; else vite build && npm run sentry:sourcemaps; fi",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier . --check --log-level warn --write \"./**/*.{js,ts,css,md,json,tsx}\"",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org dimo-hp --project dimo-login ./build && sentry-cli sourcemaps upload --org dimo-hp --project dimo-login ./build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.27",
    "@vitejs/plugin-react": "^6.1.2",
    "confusing-browser-globals": "^1.0.11",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
