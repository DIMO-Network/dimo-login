{
  "name": "dimo-login",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@dimo-network/transactions": "0.4.1",
    "@heroicons/react": "^2.2.0",
    "@sentry/cli": "^2.58.6",
    "@sentry/react": "^9.47.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@turnkey/api-key-stamper": "0.6.17",
    "@turnkey/crypto": "2.13.2",
    "@turnkey/encoding": "0.6.0",
    "@turnkey/http": "6.6.0",
    "@turnkey/webauthn-stamper": "0.6.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^25.10.10",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-mobile-app-button": "1.2.18",
    "react-scripts": "5.0.1",
    "tailwind-merge": "^2.6.1",
    "typescript": "^4.9.5",
    "viem": "2.56.8",
    "web-vitals": "^2.1.4"
  },
  "overrides": {
    "react-refresh": "0.14.2",
    "@turnkey/http": "6.6.0",
    "@turnkey/viem": "0.14.43",
    "underscore": "^1.13.8",
    "react-mobile-app-button": {
      "vite": "^6.4.5"
    }
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "if [ -z \"$SENTRY_AUTH_TOKEN\" ]; then GENERATE_SOURCEMAP=false craco build; else craco build && npm run sentry:sourcemaps; fi",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint . --ignore node_modules --ignore build",
    "lint:fix": "eslint . --fix --ignore node_modules --ignore build",
    "lint:format": "prettier . --check --log-level warn --write \"./**/*.{js,ts,css,md,json,tsx}\"",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org dimo-hp --project dimo-login ./build && sentry-cli sourcemaps upload --org dimo-hp --project dimo-login ./build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@types/lodash": "^4.17.27",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prettier": "3.5.3",
    "tailwindcss": "^3.4.19"
  }
}
